rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get current user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isPatient() {
      return isAuthenticated() && (getUserData().role == 'patient' || request.auth.token.role == 'patient');
    }
    
    function isDoctor() {
      return isAuthenticated() && (getUserData().role == 'doctor' || request.auth.token.role == 'doctor');
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || request.auth.token.role == 'admin');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        resource.data.patientId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Doctors & Availability Collection
    match /doctors/{doctorId} {
      allow read: if true; // Public directory for patients
      allow write: if isAuthenticated() && (request.auth.uid == doctorId || isAdmin());
    }

    // Doctor Working Hours & Schedules
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isDoctor() || isAdmin());
    }

    // Leave Management Collection
    match /leaves/{leaveId} {
      allow read: if isAuthenticated() && (
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (isDoctor() || isAdmin());
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Reports Metadata Collection
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isDoctor() ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (isDoctor() || isAdmin());
    }

    // Prescriptions Collection
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (isDoctor() || isAdmin());
    }

    // Payments & Invoices Collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAuthenticated();
    }

    // Patient Feedback & Ratings
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isPatient();
      allow update, delete: if isAdmin();
    }

    // Realtime Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Compliance Audit Logs (Append-Only)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit trails are immutable
    }

    // Hospital Settings & Departments
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }

    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin();
    }
  }
}
